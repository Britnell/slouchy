<!--
    Page layout: <video> with a <canvas> absolutely positioned on top (overlay)
    to draw pose landmarks/posture points over the live camera feed.
-->

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Posture Detection</title>
        <style>
            body {
                margin: 0;
                background: #111;
                color: #eee;
                font-family: system-ui, sans-serif;
                display: flex;
                flex-direction: column;
                align-items: center;
            }
            #container {
                position: relative;
                width: 100%;
                max-width: 960px;
            }
            video,
            canvas {
                width: 100%;
            }
            #canvas {
                opacity: 0.5;
            }
            canvas {
                position: absolute;
                inset: 0;
            }
            button {
                margin: 12px;
                padding: 8px 16px;
                font-size: 16px;
                cursor: pointer;
            }
            select {
                margin: 12px 8px;
            }
            #tilts {
                font-family: monospace;
                font-size: 16px;
                color: #eee;
            }
        </style>
    </head>
    <body>
        <div>
            <select id="model-select">
                <option value="lite" selected>Pose Landmarker (Lite)</option>
                <option value="full">Pose Landmarker (Full)</option>
                <option value="heavy">Pose Landmarker (Heavy)</option>
            </select>
            <button id="start">Start Camera</button>
        </div>
        <div id="container">
            <video id="video" playsinline autoplay muted></video>
            <canvas id="canvas"></canvas>
        </div>
        <pre id="tilts"></pre>

        <script src="../scripts/mediapipe.ts"></script>
    </body>
</html>
