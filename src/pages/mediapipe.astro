---
import "../styles/global.css";
---

<!--
    Page layout: <video> with a <canvas> absolutely positioned on top (overlay)
    to draw pose landmarks/posture points over the live camera feed.
-->
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>mediapipe</title>
    </head>
    <body
        class="flex min-h-screen flex-col items-center bg-neutral-900 font-sans text-neutral-200"
    >
        <div
            id="error"
            class="hidden m-3 px-3 py-1 text-base text-red-400 border border-red-400 rounded"
        >
        </div>
        <div>
            <select id="model-select" class="m-3">
                <option value="lite" selected>Pose Landmarker (Lite)</option>
                <option value="full">Pose Landmarker (Full)</option>
                <option value="heavy">Pose Landmarker (Heavy)</option>
            </select>
            <button id="start" class="m-3 cursor-pointer px-4 py-2 text-base"
                >Start Camera</button
            >
            <button id="correct" class="m-3 cursor-pointer px-4 py-2 text-base"
                >Correct Posture</button
            >
        </div>
        <div class="flex w-full max-w-[600px] flex-col gap-6">
            <div id="container" class="relative w-full">
                <video id="video" playsinline autoplay muted class="w-full"
                ></video>
                <canvas id="canvas" class="absolute inset-0 w-full opacity-50"
                ></canvas>
            </div>
            <div class="flex gap-6 lg:flex-row lg:gap-6">
                <div id="tilts" class="flex flex-col gap-1 font-mono text-base">
                </div>
                <div id="head" class="flex flex-col gap-1 font-mono text-base">
                </div>
                <div
                    id="intrinsic"
                    class="flex flex-col gap-1 font-mono text-base"
                >
                </div>
            </div>
        </div>

        <script src="../scripts/mediapipe.ts"></script>
    </body>
</html>
